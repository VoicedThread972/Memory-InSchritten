<Window x:Class="MemoryInSchritten.Client.Views.CardSetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock Text="Wählen Sie Ihre Spielkarten" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </StackPanel.Resources>
            <Button Content="Comics" Tag="comics" Click="Choose_Click" />
            <Button Content="Harry Potter" Tag="harrypotter" Click="Choose_Click" />
            <Button Content="Popstars" Tag="popstars" Click="Choose_Click" />
        </StackPanel>
    </StackPanel>
</Window>
