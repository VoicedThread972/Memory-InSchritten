<Window x:Class="MemoryInSchritten.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MemoryInSchritten.Client.Views"
        xmlns:vm="clr-namespace:MemoryInSchritten.Client.ViewModels"
        Title="Memory" Height="450" Width="800" MinHeight="320" MinWidth="560"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="16" Margin="4"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <views:PlayerPanel DockPanel.Dock="Left" Width="140" DataContext="{Binding Left}" />
        <views:PlayerPanel DockPanel.Dock="Right" Width="140" DataContext="{Binding Right}" />
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CardViewModel}">
                    <Button Margin="3" Padding="0" Background="White" BorderBrush="Black" Focusable="False" Click="Card_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
