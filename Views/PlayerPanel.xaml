<UserControl x:Class="MemoryInSchritten.Client.Views.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="4" Padding="8" CornerRadius="6" BorderBrush="Black" BorderThickness="2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="LightGray" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="DeepSkyBlue" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
            <StackPanel Width="120">
                <TextBlock Text="Spieler" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="getrennt" Foreground="DarkRed" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Rating, StringFormat=Elo {0}, TargetNullValue=''}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Score}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
        </Viewbox>
    </Border>
</UserControl>
